# Copy to .env locally. Never commit secrets.
# Default demo mode does not need a key.
EXTRACTOR_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=
DEMO_TIME=2026-10-07T10:00:00+09:00
# Bind localhost only. Demo accounts are not production authentication.
# Local accounts use this SQLite database too. Runtime database must stay private.
# Optional: set a separate file before starting a fresh competition environment.
# DATABASE_PATH=backend/data/competition.sqlite3
